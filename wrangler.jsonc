{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "careers-mcp",
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "careers",
      "database_id": "f817e7d5-d5c7-4728-9b48-49330cf61b82",
      "migrations_dir": "migrations"
    }
  ]
}
