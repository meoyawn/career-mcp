{
  "name": "careers-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "aube@2.5.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate": "wrangler d1 migrations apply careers --local",
    "db:migrate:remote": "wrangler d1 migrations apply careers --remote",
    "types": "wrangler types --env-file .dev.vars.example",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --deny-warnings src tests",
    "test": "node --test tests/*.test.ts",
    "check": "aube run typecheck && aube run lint && aube test && aube run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@simplewebauthn/server": "14.0.3",
    "@valibot/to-json-schema": "1.8.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@levischuck/tiny-cbor": "0.3.6",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxlint": "1.88.0",
    "wrangler": "4.151.0"
  }
}
